# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Google Maps Platform API Key
GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# Vertex AI Agent Engine Code Execution Sandbox
AGENT_ENGINE_SANDBOX_RESOURCE_NAME=projects/your-project-id/locations/us-central1/reasoningEngines/your-engine-id/sandboxEnvironments/your-sandbox-id
